{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VendorRFP",
  "description": "Structured RFP and contract extraction schema for vendor orchestration.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "eventId": { "type": "string", "format": "uuid" },
    "proposalDeadline": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["draft", "sent", "responded", "shortlisted", "contracted", "rejected"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "contractNotes": { "type": "string", "maxLength": 2000 },
    "vendor": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "category": {
          "type": "string",
          "enum": [
            "venue",
            "catering",
            "decor",
            "photography",
            "videography",
            "entertainment",
            "florals",
            "transportation",
            "beauty",
            "invitations",
            "cake",
            "security",
            "audio-visual"
          ]
        },
        "contactName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 20 },
        "website": { "type": "string", "format": "uri" },
        "city": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "priceRange": {
          "type": "string",
          "enum": ["budget", "mid-range", "premium", "luxury"]
        },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "category", "city", "priceRange"]
    },
    "checklistItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "question": { "type": "string", "minLength": 1, "maxLength": 400 },
          "required": { "type": "boolean", "default": true },
          "answered": { "type": "boolean", "default": false },
          "answer": { "type": "string", "maxLength": 1000 },
          "category": {
            "type": "string",
            "enum": [
              "pricing",
              "availability",
              "services",
              "logistics",
              "legal",
              "references",
              "deliverables",
              "payments"
            ]
          }
        },
        "required": ["id", "question", "required", "answered", "category"]
      }
    }
  },
  "required": [
    "id",
    "eventId",
    "vendor",
    "checklistItems",
    "proposalDeadline",
    "status",
    "generatedAt"
  ]
}

