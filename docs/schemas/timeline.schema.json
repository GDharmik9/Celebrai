{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimelineDAG",
  "description": "Directed Acyclic Graph event milestone schedule with backward-scheduled horizons.",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventDate": { "type": "string", "format": "date" },
    "planningStartDate": { "type": "string", "format": "date" },
    "horizonWeeks": { "type": "integer", "minimum": 1, "maximum": 104, "default": 12 },
    "criticalPath": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "default": []
    },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 150 },
          "description": { "type": "string", "maxLength": 500 },
          "dueDate": { "type": "string", "format": "date" },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": [
              "booking",
              "payment",
              "design",
              "logistics",
              "communication",
              "vendor",
              "guest",
              "rehearsal",
              "event-day",
              "post-event"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "default": []
          },
          "assignee": { "type": "string", "maxLength": 100 },
          "completed": { "type": "boolean", "default": false },
          "completedAt": { "type": "string", "format": "date-time" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "maxLength": 30 },
            "maxItems": 10,
            "default": []
          }
        },
        "required": ["id", "title", "dueDate", "priority", "category", "dependsOn", "completed"]
      }
    }
  },
  "required": [
    "eventId",
    "eventDate",
    "planningStartDate",
    "milestones",
    "horizonWeeks",
    "criticalPath",
    "version",
    "generatedAt"
  ]
}

